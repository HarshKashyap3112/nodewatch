# Environment Variables Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (MySQL default)
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/nodewatch
# SQLite fallback (for quick local development without MySQL server):
# DATABASE_URL=sqlite+aiosqlite:///./smp.db

# Authentication
SECRET_KEY=dev_secret_key_change_in_production_1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Monitoring Defaults
OFFLINE_TIMEOUT_SECONDS=120
ALERT_EVALUATION_INTERVAL_SECONDS=30

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Notifications (Webhook & SMTP)
WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=alerts@nodewatch.local
RECIPIENT_EMAILS=admin@example.com,ops@example.com
